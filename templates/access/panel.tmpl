<div id="panel" class="flex flex-col divide-y divide-line">
	{{if .Password}}
	<section id="password-once" class="pb-6">
		<div class="border-l-2 border-warning-border pl-4">
			<h2 class="mb-1 font-medium text-warning-text">Сохраните пароль сейчас</h2>
			<p class="mb-2 text-ink-light">Он показывается один раз и нигде не хранится. Если потеряете его, получите новые логин и пароль кнопкой внизу страницы.</p>
			<code id="password" class="code-value block select-all break-all p-2 text-ink">{{.Password}}</code>
		</div>
	</section>
	{{end}}

	<section class="{{if .Password}}py-6{{else}}pb-6{{end}}">
		<h2 class="mb-2 text-[15px] font-medium">Подключение</h2>
		<dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1">
			<dt class="text-ink-light">Хост</dt><dd><code class="break-all">{{.DBHost}}</code></dd>
			<dt class="text-ink-light">Порт</dt><dd><code>{{.DBPort}}</code></dd>
			<dt class="text-ink-light">Логин</dt><dd><code id="login" class="select-all">{{.Account.Login}}</code></dd>
			<dt class="text-ink-light">SSL</dt><dd><code>sslmode=require</code></dd>
		</dl>
	</section>

	<section class="py-6">
		<h2 class="mb-1 text-[15px] font-medium">Базы данных</h2>
		<p id="write-note" class="text-warning-text">Write-доступ действует на одну базу и будет забран через день ({{.WriteHours}} ч). После этого созданные вами таблицы останутся доступны только на чтение.</p>
		<div class="mt-2 flex flex-col divide-y divide-line">
			{{range .Databases}}{{template "access/database" dict "Name" .Name "Write" .Write "ExpiresUnix" .ExpiresUnix "Login" $.Account.Login "Password" $.Password "DBHost" $.DBHost "DBPort" $.DBPort}}{{end}}
		</div>
	</section>

	<form class="pt-6" method="post" action="/account/rotate" hx-post="/account/rotate" hx-target="#panel" hx-swap="outerHTML" hx-confirm="Текущие логин и пароль перестанут работать, активные подключения будут закрыты. Продолжить?">
		<button id="rotate" class="btn btn-primary" type="submit">Обновить логин и пароль</button>
	</form>
</div>
