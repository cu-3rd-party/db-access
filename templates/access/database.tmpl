<div id="db-{{.Name}}" class="database">
	<div class="font-mono font-medium">{{.Name}}</div>
	{{if .Login}}<code class="block select-all break-all text-xs text-gray-600 dark:text-gray-400">postgresql://{{.Login}}:{{if .Password}}{{.Password}}{{else}}ПАРОЛЬ{{end}}@{{.DBHost}}:{{.DBPort}}/{{.Name}}?sslmode=require</code>{{end}}
	<form method="post" action="/write" hx-post="/write" hx-trigger="change" hx-target="#db-{{.Name}}" hx-swap="outerHTML" class="mt-1 flex flex-wrap items-center gap-2 text-sm">
		<input type="hidden" name="database" value="{{.Name}}">
		<label class="flex items-center gap-2">
			<input type="checkbox" name="enabled" value="on" {{if .Write}}checked{{end}}>
			Получить write-доступ к {{.Name}}
		</label>
		<noscript><button class="rounded border px-2" type="submit">Применить</button></noscript>
		{{if .Write}}<span class="text-amber-700 dark:text-amber-400">до {{TimeMSK .ExpiresUnix}}</span>{{end}}
	</form>
</div>
