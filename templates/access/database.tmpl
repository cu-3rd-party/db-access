<div id="db-{{.Name}}" class="database">
	<div class="mb-1 font-mono font-medium">{{.Name}}</div>
	{{if .Login}}<code class="code-value block select-all break-all p-2 text-ink-light">postgresql://{{.Login}}:{{if .Password}}{{.Password}}{{else}}ПАРОЛЬ{{end}}@{{.DBHost}}:{{.DBPort}}/{{.Name}}?sslmode=require</code>{{end}}
	<form method="post" action="/write" hx-post="/write" hx-trigger="change" hx-target="#db-{{.Name}}" hx-swap="outerHTML" class="mt-2 flex flex-wrap items-center gap-2">
		<input type="hidden" name="database" value="{{.Name}}">
		<label class="flex items-center gap-2">
			<input class="accent-primary" type="checkbox" name="enabled" value="on" {{if .Write}}checked{{end}}>
			Получить write-доступ к {{.Name}}
		</label>
		<noscript><button class="btn btn-secondary" type="submit">Применить</button></noscript>
		{{if .Write}}<span class="text-warning-text">до {{TimeMSK .ExpiresUnix}}</span>{{end}}
	</form>
</div>
